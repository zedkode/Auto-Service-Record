# =============================================================================
# AutoServices — Environment Variables
# =============================================================================
# Copy to .env and adjust. The defaults below work with `docker compose up -d`
# for local development — no cloud account, no API keys, no real email.
#
# NEVER commit a real .env. NEVER put a real secret in this file.
# packages/config validates every variable at startup and REFUSES TO START on a
# missing, malformed, or still-placeholder value. That is deliberate: failing at
# boot beats discovering at 3 a.m. that reminder emails went nowhere for a week.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development                      # development | test | production
LOG_LEVEL=debug                           # trace | debug | info | warn | error | fatal

# -----------------------------------------------------------------------------
# Application URLs
# Used for CORS allow-listing, cookie domains and absolute links in emails.
# Email CTA links are built from these — get them wrong and every link 404s.
# -----------------------------------------------------------------------------
MARKETING_URL=http://localhost:3100
APP_URL=http://localhost:3101
ADMIN_URL=http://localhost:3102
API_URL=http://localhost:4100

API_PORT=4100
MARKETING_PORT=3100
DASHBOARD_PORT=3101
ADMIN_PORT=3102

# -----------------------------------------------------------------------------
# Infrastructure host ports
# Deliberately non-default so this stack cannot collide with another Postgres/Redis/
# MinIO/Mailpit already running on the machine. Container-internal ports are standard.
# -----------------------------------------------------------------------------
POSTGRES_PORT=55432
REDIS_PORT=56379
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025

# -----------------------------------------------------------------------------
# Database  (PostgreSQL 18)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://autoservices:autoservices@localhost:55432/autoservices?schema=public
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Separate database for integration tests — NEVER point this at a real database.
TEST_DATABASE_URL=postgresql://autoservices:autoservices@localhost:55432/autoservices_test?schema=public

# -----------------------------------------------------------------------------
# Redis  (sessions-adjacent caching, rate limiting, BullMQ)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:56379
REDIS_QUEUE_PREFIX=autoservices

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate with:  openssl rand -base64 48
# MUST be changed before any deployment. The config validator rejects this value.
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
SESSION_COOKIE_NAME=as_session
ADMIN_SESSION_COOKIE_NAME=as_admin_session
SESSION_COOKIE_DOMAIN=localhost            # e.g. .example.com in production
SESSION_ABSOLUTE_LIFETIME_DAYS=30
SESSION_IDLE_TIMEOUT_DAYS=14
ADMIN_SESSION_LIFETIME_HOURS=8

# Salt for hashing IP addresses before storage. Enough to spot anomalies,
# not enough to reconstruct a location history. Rotate with care: rotating
# invalidates historical correlation.
IP_HASH_SALT=CHANGE_ME_generate_with_openssl_rand_base64_32

CSRF_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# Argon2id — OWASP minimums. Do not lower these for production.
ARGON2_MEMORY_COST=19456                  # KiB (19 MiB)
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# -----------------------------------------------------------------------------
# Rate limiting  (see SECURITY.md §8)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=3
RATE_LIMIT_API_PER_MINUTE=300

# -----------------------------------------------------------------------------
# Email
# MAIL_TRANSPORT: resend | smtp | memory
#   resend → production/staging
#   smtp   → local development, delivers to Mailpit (nothing leaves your machine)
#   memory → tests. ResendTransport THROWS when NODE_ENV=test.
# -----------------------------------------------------------------------------
MAIL_TRANSPORT=smtp

SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_SECURE=false

RESEND_API_KEY=                            # required only when MAIL_TRANSPORT=resend
RESEND_WEBHOOK_SECRET=                     # required only when MAIL_TRANSPORT=resend

MAIL_FROM_NAME=AutoServices
MAIL_FROM_EMAIL=notifications@example.com
MAIL_REPLY_TO=support@example.com

# Absolute safety net for non-production environments: when set, EVERY outbound
# email is redirected here regardless of recipient. Leave empty in production.
MAIL_OVERRIDE_RECIPIENT=

# -----------------------------------------------------------------------------
# Object storage  (S3-compatible; MinIO locally)
# The bucket MUST be private. No public read, no public list, no website hosting.
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=autoservices
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true                   # true for MinIO, false for most cloud providers
S3_PUBLIC_ENDPOINT=http://localhost:59000   # host used when signing browser-facing URLs

UPLOAD_MAX_BYTES=20971520                  # 20 MB
UPLOAD_URL_TTL_SECONDS=900                 # 15 minutes for presigned PUT
DOWNLOAD_URL_TTL_SECONDS=300               # 5 minutes for presigned GET
ALLOWED_UPLOAD_MIME=application/pdf,image/jpeg,image/png,image/webp,image/heic

# -----------------------------------------------------------------------------
# Background jobs and scheduling
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=5
JOB_ATTEMPTS_DEFAULT=3
JOB_BACKOFF_BASE_MS=30000

REMINDER_SEND_HOUR_LOCAL=9                 # 09:00 in the recipient's timezone
QUIET_HOURS_START_LOCAL=21
QUIET_HOURS_END_LOCAL=7
ODOMETER_STALE_AFTER_DAYS=45

# -----------------------------------------------------------------------------
# Defaults for new workspaces
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY=GBP
DEFAULT_DISTANCE_UNIT=MILES                # MILES | KILOMETERS
DEFAULT_TIMEZONE=Europe/London
DEFAULT_LOCALE=en-GB

# -----------------------------------------------------------------------------
# Feature flags  (bootstrap only; runtime values live in the feature_flags table)
# -----------------------------------------------------------------------------
FEATURE_ADVANCED_REPORTS=false
FEATURE_FLEET_MODE=false
FEATURE_VEHICLE_SHARING=false
FEATURE_DOCUMENT_EXPORT=false
FEATURE_API_ACCESS=false

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
HEALTH_CHECK_TIMEOUT_MS=3000
OPENAPI_ENABLED=true                       # forced off in production

# -----------------------------------------------------------------------------
# Frontend build-time variables (read by Vite from this file)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:4100
