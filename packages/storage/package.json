{
  "name": "@autoservices/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@autoservices/types": "workspace:*",
    "@aws-sdk/client-s3": "3.980.0",
    "@aws-sdk/s3-request-presigner": "3.980.0"
  },
  "devDependencies": {
    "@autoservices/tsconfig": "workspace:*",
    "@autoservices/eslint-config": "workspace:*",
    "@types/node": "24.10.1",
    "eslint": "10.11.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
